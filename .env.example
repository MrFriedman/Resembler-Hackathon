# Backend (Flask + MongoDB). Copy this file to .env in the repo root.
# database.py reads MONGODB_URI from the environment, then from that .env file.
# Do not commit a real .env. URL-encode reserved characters in the password.
# authSource=admin matches the root user created by docker-compose.

MONGO_INITDB_ROOT_USERNAME=aihackathon
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-password
MONGODB_URI=mongodb://aihackathon:replace-with-a-password@localhost:27017/db?authSource=admin

# --- Frontend (Next.js lives in Frontend/, not the repo root) ---
# Next.js loads env files from Frontend/ only. See Frontend/.env.example.
# Demo mode is on by default when NEXT_PUBLIC_API_URL is unset, so a Vercel
# deploy of this demo needs no environment variables.
#
# NEXT_PUBLIC_DEMO_MODE=true
# NEXT_PUBLIC_API_URL=http://localhost:5000
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
