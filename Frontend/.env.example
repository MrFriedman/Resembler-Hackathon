# Copy to Frontend/.env.local. None of these are required for the Vercel demo.
#
# Demo mode is ON by default when NEXT_PUBLIC_API_URL is unset.
# It serves seeded claims, incidents, close calls, and map points from
# Frontend/data/demo-seed.json and signs in a demo user without NEXTAUTH_SECRET.
#
# Set NEXT_PUBLIC_DEMO_MODE=false to call the Flask API. Then set
# NEXT_PUBLIC_API_URL, NEXTAUTH_URL, and NEXTAUTH_SECRET.

NEXT_PUBLIC_DEMO_MODE=
NEXT_PUBLIC_API_URL=

# Only required when demo mode is off.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
